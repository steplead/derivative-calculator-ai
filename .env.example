# =============================================================================
# DerivativeCalculatorAI — Environment Variables
# =============================================================================
# Copy this file to .env.local for local development.
# For production (Cloudflare Pages), configure all variables in:
#   Cloudflare Dashboard → Workers & Pages → derivative-calculator-ai →
#   Settings → Environment Variables
#
# IMPORTANT: Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# All secrets below are server-side only and MUST NOT use the NEXT_PUBLIC_ prefix.
# =============================================================================

# --- AI / API ---
# OpenRouter API key for AI-powered step-by-step explanations.
# Without this key, AI explanations are disabled but the calculator still works.
OPENROUTER_API_KEY=

# Google Gemini API key (legacy, optional).
GEMINI_API_KEY=

# --- Redis / Upstash (Rate Limiting) ---
# Rate limiting falls back to D1 if Redis is not configured.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Security: Admin Monitoring Authentication ---
# Shared secret for admin endpoint access (Bearer token auth only).
# Production: REQUIRED. If missing, all admin endpoints return 401 (fail closed).
# Development: Optional — localhost is allowed without token for convenience.
# Must be a strong random string. Example generation:
#   openssl rand -hex 32
ADMIN_MONITORING_TOKEN=

# --- Security: IP Address Hashing ---
# Server-side salt for HMAC-SHA256 IP address hashing in admin monitoring endpoints.
# Production: REQUIRED. If missing, all IPs are redacted as 'ip_redacted' in monitoring
#   outputs. Admin monitoring endpoints that require IP data (e.g., /api/ip-stats)
#   will return 503 (fail closed). No fallback salt is ever used in production.
# Development: Optional — a dev-only fallback salt is used for local testing.
# Must be 32+ characters, random. Example generation:
#   openssl rand -hex 32
MONITORING_HASH_SALT=

# --- Turnstile (Bot Protection) ---
# Cloudflare Turnstile site key and secret key for CAPTCHA verification.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Database ---
# Cloudflare D1 is auto-configured via Cloudflare Pages binding — no env var needed.
